# Second Brain Configuration
# Copy this file to .env and customize

# Path to your Obsidian vault (absolute path)
VAULT_PATH="$HOME/SecondBrain"

# Git remote URL for syncing (HTTPS or SSH)
GIT_REMOTE="https://github.com/yourusername/secondbrain.git"

# Git branch to sync with
GIT_BRANCH="main"

# Sync interval in minutes (used by cron and daemon mode)
SYNC_INTERVAL=10

# Commit message prefix
COMMIT_PREFIX="vault"

# Enable automatic conflict resolution (rebase strategy)
AUTO_RESOLVE_CONFLICTS=true

# Log file location
LOG_FILE="$HOME/.secondbrain/sync.log"

# Maximum log file size in MB (logs rotate when exceeded)
LOG_MAX_SIZE=10

# Enable desktop notifications (requires notify-send on Linux, osascript on macOS)
NOTIFICATIONS=true

# Exclude patterns (comma-separated, added to .gitignore)
EXCLUDE_PATTERNS=".obsidian/workspace*.json,.obsidian/hotkeys.json,.trash,.DS_Store"
